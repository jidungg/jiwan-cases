        <mxCell id="base3" value="기지 슬롯 3&lt;br&gt;&lt;font color=&quot;#6a6a6a&quot; style=&quot;font-size:11px&quot;&gt;Region.Base.03&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#1a1a1a;strokeWidth=1.2;fontFamily=Malgun Gothic;fontSize=12;fontColor=#1a1a1a;" parent="1" vertex="1">
          <mxGeometry x="804" y="176" width="134" height="76" as="geometry" />
        </mxCell>
        <mxCell id="baseNote" value="좌표를 넓게 벌려 배치 — 격리용이 아니라 콜리전·내브메시 정합성용." style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Malgun Gothic;fontSize=11;fontColor=#6a6a6a;" parent="1" vertex="1">
          <mxGeometry x="356" y="262" width="584" height="20" as="geometry" />
        </mxCell>
        <mxCell id="raidGroup" value="&lt;b&gt;약탈 지역 6~7개 · 온디맨드 스트리밍&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6a6a6a&quot; style=&quot;font-size:11px&quot;&gt;ULevelStreamingDynamic · 서버·클라 동일한 인스턴스 이름으로 생성&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;fillColor=none;strokeColor=#8a8a8a;strokeWidth=1.2;dashed=1;dashPattern=4 3;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Malgun Gothic;fontSize=12;fontColor=#1a1a1a;" parent="1" vertex="1">
