        <mxCell id="relevancy" value="&lt;b&gt;넷 렐러번시 게이트&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4a4a4a&quot; style=&quot;font-size:12px&quot;&gt;IsNetRelevantFor 오버라이드&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#4a4a4a&quot; style=&quot;font-size:12px&quot;&gt;RegionId 다르면 컬링&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#4a4a4a&quot; style=&quot;font-size:12px&quot;&gt;= 개인 기지 소프트 격리&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f4f4f4;strokeColor=#1a1a1a;strokeWidth=1.3;fontFamily=Malgun Gothic;fontSize=12;fontColor=#1a1a1a;" parent="1" vertex="1">
