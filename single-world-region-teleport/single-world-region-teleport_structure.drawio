        <mxCell id="raid1" value="Region.Raid.01&lt;br&gt;&lt;font color=&quot;#6a6a6a&quot; style=&quot;font-size:11px&quot;&gt;Region1.umap&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#4a4a4a&quot; style=&quot;font-size:11px&quot;&gt;refcount 2&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#1a1a1a;strokeWidth=1.2;fontFamily=Malgun Gothic;fontSize=12;fontColor=#1a1a1a;" parent="1" vertex="1">
