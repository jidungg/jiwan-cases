        <mxCell id="streaming" value="&lt;b&gt;UDogongRegionStreamingSubsystem&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4a4a4a&quot; style=&quot;font-size:12px&quot;&gt;진입 = 로드 (refcount++)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#4a4a4a&quot; style=&quot;font-size:12px&quot;&gt;마지막 이탈 = 언로드&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#4a4a4a&quot; style=&quot;font-size:12px&quot;&gt;= 다음 진입 시 리셋&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f4f4f4;strokeColor=#1a1a1a;strokeWidth=1.3;fontFamily=Malgun Gothic;fontSize=12;fontColor=#1a1a1a;" parent="1" vertex="1">
