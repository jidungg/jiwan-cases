        <mxCell id="raid3" value="Region.Raid.03 …&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;미로드&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;refcount 0&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#fafafa;strokeColor=#b4b4b4;strokeWidth=1.2;dashed=1;dashPattern=4 3;fontFamily=Malgun Gothic;fontSize=12;fontColor=#8a8a8a;" parent="1" vertex="1">
          <mxGeometry x="760" y="386" width="180" height="82" as="geometry" />
        </mxCell>
        <mxCell id="raidNote" value="언로드 경계 = 리셋 경계. 완전히 비워져 언로드되면 다음 진입은 새 인스턴스 —&lt;br&gt;루트·적이 초기 상태. 점유 중이면 리셋되지 않아 뒤따라 온 친구가 같은 루트를 본다." style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Malgun Gothic;fontSize=11;fontColor=#6a6a6a;" parent="1" vertex="1">
          <mxGeometry x="356" y="488" width="584" height="34" as="geometry" />
        </mxCell>
        <mxCell id="login" value="플레이어 접속" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#1a1a1a;strokeWidth=1.3;fontFamily=Malgun Gothic;fontSize=13;fontColor=#1a1a1a;" parent="1" vertex="1">
          <mxGeometry x="-80" y="44" width="266" height="40" as="geometry" />
        </mxCell>
        <mxCell id="postlogin" value="&lt;b&gt;ADogongRunGameMode::PostLogin&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#4a4a4a&quot; style=&quot;font-size:12px&quot;&gt;빈 기지 슬롯(0~3) 배정 · 서버 권위&lt;/font&gt;" style="rounded=1;absoluteArcSize=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#f4f4f4;strokeColor=#1a1a1a;strokeWidth=1.3;fontFamily=Malgun Gothic;fontSize=12;fontColor=#1a1a1a;" parent="1" vertex="1">
          <mxGeometry x="-80" y="116" width="266" height="58" as="geometry" />
